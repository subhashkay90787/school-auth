# Copy to .env and adjust. docker compose reads .env automatically;
# for the Spring app, export these (or use your IDE run configuration).

# --- Infrastructure (docker-compose.yml) ---
POSTGRES_DB=school_platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=redis
REDIS_PORT=6379

# --- Application ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/school_platform_db?currentSchema=identity
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
REDIS_HOST=localhost

# Token signing key (generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem)
JWT_PRIVATE_KEY=file:keys/jwt-private.pem
# Public URL other services use to reach this server; must match the "iss" they validate
OAUTH2_ISSUER_URL=http://localhost:8080

# Super user bootstrapped on startup (created if missing, flagged as super user)
SUPER_USER_EMAIL=you@example.com
SUPER_USER_PHONE=+919999999999
SUPER_USER_FIRST_NAME=Super
SUPER_USER_LAST_NAME=User

# Social login credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
